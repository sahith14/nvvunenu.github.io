rules_version = '2';

// =====================================================================
// Nuvvu Nenu — Firestore Security Rules (Couple-Only)
//
// Data model:
//   users/{uid}
//   chats/{coupleId}                  (coupleId = [uidA,uidB].sort().join("_"))
//   chats/{coupleId}/messages/{mid}
//   calls/{coupleId}                  (status doc for ringing/active/ended)
//   calls/{coupleId}/signaling/{sid}
//   memories/{coupleId}/entries/{eid}
//   gifts/{docId}                     (flat collection, has from/to fields)
//   lovenotes/{docId}                 (flat collection, has from/to fields)
//   letters/{coupleId}/entries/{eid}
//   dateideas/{coupleId}/saved/{eid}
//   events/{coupleId}/entries/{eid}
//   pets/{coupleId}
//   checkins/{uid}_{YYYY-MM-DD}
//   streaks/{uid}
//   couples/{coupleId}
//   reports/{docId}
//
// NOTE: This is a couple app. There is intentionally NO public feed
// (posts/comments) and NO follower/following graph.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(u) { return signedIn() && uid() == u; }

    // coupleId has form "<uid1>_<uid2>" with uid1 < uid2 lexicographically.
    function inCouple(coupleId) {
      let parts = coupleId.split("_");
      return signedIn()
        && parts.size() == 2
        && (uid() == parts[0] || uid() == parts[1]);
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        // Partner can update ONLY partner-request / pairing fields on the other side.
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['partnerRequestFrom','partnerRequestTo','partnerRequestAt','partnerID','relationshipStatus','matchedAt']))
        // Any signed-in user may toggle ONLY follower/following arrays on another user
        // (used for follow/unfollow on the public Feed).
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['followers','following','followerCount','followingCount']));
      allow delete: if isOwner(userId);
    }

    // ---------- usernames namespace (unique-name reservation) ----------
    // Each doc id is the lowercase username; doc body has { uid }.
    match /usernames/{uname} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
      // No updates — to change username, delete the old doc and create a new one.
      allow update: if false;
    }

    // ---------- couple-scoped: chats ----------
    match /chats/{coupleId} {
      allow read, write: if inCouple(coupleId);

      match /messages/{msgId} {
        allow read: if inCouple(coupleId);
        allow create: if inCouple(coupleId)
          && request.resource.data.sender == uid();
        allow update: if inCouple(coupleId)
          && (
            // deliveredAt/seenAt/reactions/votes writable by the non-sender too
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deliveredAt','seenAt','status','reactions','votes'])
            // Author can edit their own message text + flag editedAt
            || (resource.data.sender == uid()
                && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['text','editedAt']))
          );
        allow delete: if inCouple(coupleId)
          && resource.data.sender == uid();
      }
    }

    // ---------- couple-scoped: calls (status doc + signaling) ----------
    match /calls/{coupleId} {
      allow read, write: if inCouple(coupleId);

      match /signaling/{sigId} {
        allow read, create: if inCouple(coupleId);
        allow delete:       if inCouple(coupleId);
      }
    }

    // ---------- couple-scoped: memories ----------
    match /memories/{coupleId}/entries/{entryId} {
      allow read: if inCouple(coupleId);
      allow create: if inCouple(coupleId)
        && (request.resource.data.createdBy == uid()
            || request.resource.data.addedBy == uid());
      allow update, delete: if inCouple(coupleId);
    }
    // Legacy structure used by frontend: memories/{coupleId}/items/{itemId}
    match /memories/{coupleId}/items/{itemId} {
      allow read: if inCouple(coupleId);
      allow create: if inCouple(coupleId)
        && (request.resource.data.addedBy == uid()
            || request.resource.data.createdBy == uid());
      allow update, delete: if inCouple(coupleId);
    }

    // ---------- couple-scoped: letters ----------
    match /letters/{coupleId}/entries/{entryId} {
      allow read: if inCouple(coupleId);
      allow create: if inCouple(coupleId)
        && request.resource.data.writtenBy == uid();
      allow delete: if inCouple(coupleId);
    }

    // ---------- couple-scoped: date ideas ----------
    match /dateideas/{coupleId}/saved/{entryId} {
      allow read: if inCouple(coupleId);
      allow create: if inCouple(coupleId)
        && request.resource.data.savedBy == uid();
      allow delete: if inCouple(coupleId);
    }

    // ---------- couple-scoped: calendar events ----------
    match /events/{coupleId}/entries/{entryId} {
      allow read: if inCouple(coupleId);
      allow create: if inCouple(coupleId)
        && request.resource.data.createdBy == uid();
      allow update, delete: if inCouple(coupleId);
    }

    // ---------- couple-scoped: pet ----------
    match /pets/{coupleId} {
      allow read, write: if inCouple(coupleId);
    }

    // ---------- gifts (flat collection, has from/to) ----------
    match /gifts/{docId} {
      allow read: if signedIn()
        && (resource.data.from == uid() || resource.data.to == uid());
      allow create: if signedIn()
        && request.resource.data.from == uid()
        && request.resource.data.to is string
        && request.resource.data.to != uid();
      allow update: if signedIn()
        && resource.data.to == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow delete: if signedIn()
        && (resource.data.from == uid() || resource.data.to == uid());
    }

    // ---------- love notes (flat, has from/to) ----------
    match /lovenotes/{docId} {
      allow read: if signedIn()
        && (resource.data.from == uid() || resource.data.to == uid());
      allow create: if signedIn()
        && request.resource.data.from == uid();
      allow update: if signedIn()
        && resource.data.to == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen','unlocked']);
      allow delete: if signedIn()
        && (resource.data.from == uid() || resource.data.to == uid());
    }

    // ---------- per-user: check-ins ----------
    match /checkins/{checkinId} {
      allow read: if signedIn();          // partner can read partner's check-in
      allow create, update, delete: if signedIn()
        && (checkinId == uid() || checkinId.matches(uid() + "_.*"));
    }

    // ---------- per-user: streaks ----------
    match /streaks/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);
    }

    // ---------- per-user: notifications + surprises (kiss / love note feed) ----------
    match /notifications/{userId} {
      allow read:   if isOwner(userId);
      // anyone signed in (i.e. their partner) can post a notification to a target user
      allow create, update: if signedIn();
      allow delete: if isOwner(userId);
    }

    match /surprises/{docId} {
      allow read: if signedIn()
        && (resource.data.from == uid() || resource.data.to == uid());
      allow create: if signedIn() && request.resource.data.from == uid();
      allow update: if signedIn() && resource.data.to == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opened','seen']);
      allow delete: if signedIn()
        && (resource.data.from == uid() || resource.data.to == uid());
    }

    match /touches/{userId} {
      allow read:   if isOwner(userId);
      allow create, update: if signedIn();
      allow delete: if isOwner(userId);
    }

    // ---------- watch sessions (couple-scoped) ----------
    match /watchSessions/{coupleId} {
      allow read, write: if inCouple(coupleId);
      match /reactions/{rid} {
        allow read:   if inCouple(coupleId);
        allow create: if inCouple(coupleId)
          && request.resource.data.by == uid();
        allow delete: if inCouple(coupleId);
      }
    }

    // ---------- music rooms (couple-scoped, mirrors watchSessions) ----------
    match /musicRooms/{coupleId} {
      allow read, write: if inCouple(coupleId);
      match /reactions/{rid} {
        allow read:   if inCouple(coupleId);
        allow create: if inCouple(coupleId)
          && request.resource.data.by == uid();
        allow delete: if inCouple(coupleId);
      }
    }

    // ---------- bonds (couple-scoped) ----------
    match /bonds/{coupleId} {
      allow read, write: if inCouple(coupleId);
      match /goals/{goalId} {
        allow read, write: if inCouple(coupleId);
      }
      match /events/{eventId} {
        allow read, write: if inCouple(coupleId);
      }
      match /qotw/{weekId} {
        allow read, write: if inCouple(coupleId);
      }
      match /kindness/{actId} {
        allow read:   if inCouple(coupleId);
        allow create: if inCouple(coupleId)
          && request.resource.data.by == uid();
        allow delete: if inCouple(coupleId)
          && resource.data.by == uid();
      }
      match /timecapsule/{letterId} {
        allow read:   if inCouple(coupleId);
        allow create: if inCouple(coupleId)
          && request.resource.data.from == uid();
        // Either partner can mark a letter as opened (set opened/openedAt).
        allow update: if inCouple(coupleId);
        // Only the author can discard a sealed letter.
        allow delete: if inCouple(coupleId)
          && resource.data.from == uid();
      }
      match /dates/{ideaId} {
        allow read, write: if inCouple(coupleId);
      }
      match /bucket/{itemId} {
        allow read, write: if inCouple(coupleId);
      }
      match /pulseHistory/{dayKey} {
        allow read, write: if inCouple(coupleId);
      }
    }

    // ---------- subscriptions (per user) ----------
    match /subscriptions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ---------- couples (meta, stats, pokes) ----------
    match /couples/{coupleId} {
      allow read, write: if inCouple(coupleId);

      // Meta/stats: startedAt, bondScore, moods, lastPokeAt
      match /meta/{metaId} {
        allow read: if inCouple(coupleId);
        allow create, update, delete: if inCouple(coupleId);
      }

      // Thinking-of-you pokes
      match /pokes/{pokeId} {
        allow read: if inCouple(coupleId);
        allow create: if inCouple(coupleId)
          && request.resource.data.from == uid();
        allow delete: if inCouple(coupleId);
      }

      // Call history — written when a call ends. Sender is the user
      // closing the UI (could be either side; both write their own row).
      match /callHistory/{callId} {
        allow read: if inCouple(coupleId);
        allow create: if inCouple(coupleId)
          && request.resource.data.sender == uid();
        allow delete: if inCouple(coupleId);
      }

      // Shared memories within couple
      match /memories/{memId} {
        allow read, write: if inCouple(coupleId);
      }
    }

    // ---------- public feed: posts + comments + likes ----------
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == uid();
      // Owner can freely update/delete; anyone signed-in may toggle likes
      // or bump the comment counter.
      allow update: if (signedIn() && resource.data.owner == uid())
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likes','likeCount','commentCount']));
      allow delete: if signedIn() && resource.data.owner == uid();

      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.author == uid();
        allow update, delete: if signedIn() && resource.data.author == uid();
      }
    }

    // ---------- reports (write-only for users) ----------
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid();
      allow read, update, delete: if false;
    }

    // ---------- subscription (per-user plan + usage counters) ----------
    match /users/{userId}/subscription/{subDoc} {
      allow read, write: if isOwner(userId);
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
