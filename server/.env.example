PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT (separate from Supabase's — used for socket auth)
JWT_SECRET=change_me_long_random
JWT_ISSUER=bondsync
JWT_AUDIENCE=bondsync-client

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sbs_service_role_key_here
SUPABASE_ANON_KEY=sbs_anon_key_here

# Rate limiting
CHAT_RATE_MAX=30
CHAT_RATE_WINDOW_MS=10000
